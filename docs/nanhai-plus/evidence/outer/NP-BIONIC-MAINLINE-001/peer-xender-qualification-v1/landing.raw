oading"><div class="pace pace-active"><div class="pace-progress" data-progress="50" data-progress-text="50%" style="-webkit-transform:translate3d(50%,0,0);-ms-transform:translate3d(50%,0,0);transform:translate3d(50%,0,0)"><div class="pace-progress-inner"></div></div><div class="pace-activity"></div></div></div><div id="app" style="display:none"><div class="xd_nav"><div class="nav_left" id="xd_logo"><img src="data:image/png;base64," alt="Xender Logo"/><h1 id="country_code"></h1><div class="nav_item"></div></div><div class="nav_right"><div class="nav_icon active" id="page_home" data-path="/">Home</div><div class="nav_icon selection down" id="selection_file_transfer" data-path="selection">File Transfer</div><div class="nav_icon selection down" id="selection_file_media" data-path="selection">File & Media</div><div class="nav_icon" id="page_ai_experience" data-path="/ai_experience.html">AI Experience</div><div class="lang_cnt"><div class="lang_select" id="lang_select"><span id="current_lang">English</span> <img id="arrow_lang" src="data:image/svg+xml;base64," alt=""></div><div id="lang_opts" class="lang_opts"><div class="lang_opt"><span data-lang="en">English</span></div><div class="lang_opt"><span data-lang="fr">Français</span></div><div class="lang_opt"><span data-lang="de">Deutsch</span></div><div class="lang_opt"><span data-lang="it">italiano</span></div><div class="lang_opt"><span data-lang="es">Española</span></div><div class="lang_opt"><span data-lang="pt">Português</span></div><div class="lang_opt"><span data-lang="pl">Polski</span></div><div class="lang_opt"><span data-lang="uk">українська</span></div><div class="lang_opt"><span data-lang="ro">Romanian</span></div><div class="lang_opt"><span data-lang="nl">Nederlands</span></div><div class="lang_opt"><span data-lang="ar">عربي</span></div><div class="lang_opt"><span data-lang="sw">kiswahili</span></div><div class="lang_opt"><span data-lang="zh-HK">中文香港</span></div><div class="lang_opt"><span data-lang="zh-TW">中文台